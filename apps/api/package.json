{
  "name": "@gsa/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply gsa-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply gsa-db --remote",
    "db:seed:local": "node scripts/seed.mjs && wrangler d1 execute gsa-db --local --file=scripts/seed.sql"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "jose": "^5.9.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  }
}
