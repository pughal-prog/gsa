<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only, except plain HTTP to the phone's own loopback address. That is reachable only through
     "adb reverse" over the USB cable, so it is for testing against a local API and exposes nothing on any network. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
