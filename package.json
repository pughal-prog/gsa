{
  "name": "global-sports-academy",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["apps/api", "apps/web"],
  "scripts": {
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "build:web": "npm run build -w apps/web",
    "typecheck": "npm run typecheck -w apps/api && npm run typecheck -w apps/web",
    "db:migrate:local": "npm run db:migrate:local -w apps/api",
    "db:seed:local": "npm run db:seed:local -w apps/api"
  }
}
